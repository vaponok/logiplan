{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "logiplan",
  "version": "0.1.0",
  "identifier": "com.vaponok.logiplan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Combined Foxhole Tools",
        "width": 1428,
        "height": 928,
        "minWidth": 928,
        "minHeight": 628,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Vaponok",
    "shortDescription": "Combined Foxhole Tools",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Russian", "English", "French"], "displayLanguageSelector": false }
    }
  }
}
